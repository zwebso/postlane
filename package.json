{
  "name": "postlane",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "db:migrate": "wrangler d1 execute postlane --local --file=schema/001_init.sql",
    "db:migrate:remote": "wrangler d1 execute postlane --remote --file=schema/001_init.sql",
    "deploy": "vite build && wrangler deploy --var ENVIRONMENT:production --var MAIL_PROVIDER:cloudflare --var APP_ORIGIN:https://www.postlane.email --var SYSTEM_MAIL_FROM:noreply@postlane.email --var CLOUDFLARE_ACCOUNT_ID:3450dcc5bfb29cbb7f9dcf32866a848e --var DOMAIN_CONNECT_LIVE:1 --var OPERATOR_EMAILS:zwebso@gmail.com"
  },
  "dependencies": {
    "hono": "^4.9.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.5",
    "@cloudflare/workers-types": "^5.20260919.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.6",
    "vitest": "^3.2.4",
    "wrangler": "^4.38.0"
  }
}
